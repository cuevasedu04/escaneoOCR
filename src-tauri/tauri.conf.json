{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "BuscadorDocumentos",
  "version": "1.0.0",
  "identifier": "mx.gob.anam.ocrdocumentos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Búsqueda de Documentos — ANAM",
        "backgroundColor": "#0A1A17",
        "width": 1280,
        "height": 820,
        "minWidth": 1020,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
